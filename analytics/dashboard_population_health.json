{
  "display_name": "Population Health \u2014 Unity Health",
  "serialized": {
    "datasets": [
      {
        "name": "ph_kpi",
        "displayName": "Pop Health KPIs",
        "queryLines": [
          "SELECT\n            (SELECT count(DISTINCT r.patient_id) FROM hls_provider.population_health.patient_registry r\n                JOIN (SELECT DISTINCT patient_id FROM hls_provider.population_health.care_gaps WHERE gap_status='Open') g\n                ON r.patient_id=g.patient_id WHERE r.risk_tier IN ('High','Rising')) AS care_managed_pop,\n            (SELECT count(*) FROM hls_provider.population_health.patient_registry WHERE risk_tier='High') AS high_risk,\n            (SELECT count(*) FROM hls_provider.population_health.care_gaps WHERE gap_status='Open') AS open_gaps,\n            (SELECT avg(CASE WHEN gap_status='Closed' THEN 1.0 ELSE 0 END) FROM hls_provider.population_health.care_gaps) AS closure_rate,\n            (SELECT avg(predicted_annual_cost) FROM hls_provider.population_health.risk_scores) AS avg_cost,\n            (SELECT avg(CASE WHEN transportation_barrier OR food_insecurity OR housing_instability THEN 1.0 ELSE 0 END) FROM hls_provider.population_health.sdoh) AS sdoh_barrier_rate"
        ]
      },
      {
        "name": "ph_risk_dist",
        "displayName": "Risk Tier Distribution",
        "queryLines": [
          "SELECT risk_tier, count(*) AS patients FROM hls_provider.population_health.patient_registry GROUP BY 1"
        ]
      },
      {
        "name": "ph_gaps_measure",
        "displayName": "Open Gaps by Measure",
        "queryLines": [
          "SELECT measure, count(*) AS open_gaps FROM hls_provider.population_health.care_gaps WHERE gap_status='Open' GROUP BY 1"
        ]
      },
      {
        "name": "ph_closure_measure",
        "displayName": "Closure Rate by Measure",
        "queryLines": [
          "SELECT measure, avg(CASE WHEN gap_status='Closed' THEN 1.0 ELSE 0 END) AS closure_rate FROM hls_provider.population_health.care_gaps GROUP BY 1"
        ]
      },
      {
        "name": "ph_sdoh",
        "displayName": "SDOH Barriers",
        "queryLines": [
          "SELECT 'Transportation' AS barrier, sum(CASE WHEN transportation_barrier THEN 1 ELSE 0 END) AS patients FROM hls_provider.population_health.sdoh\n            UNION ALL SELECT 'Food insecurity', sum(CASE WHEN food_insecurity THEN 1 ELSE 0 END) FROM hls_provider.population_health.sdoh\n            UNION ALL SELECT 'Housing instability', sum(CASE WHEN housing_instability THEN 1 ELSE 0 END) FROM hls_provider.population_health.sdoh\n            UNION ALL SELECT 'Interpreter needed', sum(CASE WHEN interpreter_needed THEN 1 ELSE 0 END) FROM hls_provider.population_health.sdoh"
        ]
      }
    ],
